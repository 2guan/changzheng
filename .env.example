# 复制为 .env.local，与 compose.yaml 放在同一目录。
# 由服务端读取，请勿添加 VITE_ 前缀；SITE_PRODUCER 系列为公开展示文字。
MIMO_API_KEY=请替换为你的小米MiMo密钥

# 发言人。未设置或留空时使用白桦。
MIMO_TTS_VOICE=白桦

# 演绎提示词。留空时不发送任何风格指令，使用所选发言人的默认表现。
MIMO_TTS_PROMPT=
# 如需自定义，可将上一行改为：
# MIMO_TTS_PROMPT="语速稍慢，句间自然停顿。"

# 修改后执行：docker compose up -d --no-build --pull never --force-recreate
# 接口地址、模型和容器端口 4061 无需配置。

# 版本信息卡片中的两行文字。未配置时第一行为“纪念长征胜利90周年专题”。
# 第二行可选；留空不显示。只影响版本信息卡片。
SITE_PRODUCER=纪念长征胜利90周年专题
SITE_PRODUCER_BRANCH=
